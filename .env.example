# ============================================================================
# WFOOD — пример переменных окружения
# Скопируйте в .env.local и заполните своими значениями.
#
# ⚠️ ВАЖНО ПРО ПРЕФИКС VITE_:
#   VITE_*  → попадают в JS-бандл, их увидит любой в браузере.
#             Здесь только ПУБЛИЧНЫЕ значения (URL, anon-ключ, настройки).
#   без VITE_ → НЕ попадают в бандл. Секретные ключи в этот файл вообще
#             не кладём — они живут только в Supabase Secrets (см. ниже).
#
# ⚠️ Этот файл можно коммитить. Файл .env.local — НЕЛЬЗЯ (он в .gitignore).
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — ПУБЛИЧНЫЕ, нужны фронтенду
# Где взять: https://supabase.com/dashboard → ваш проект → Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Приложение — ПУБЛИЧНЫЕ настройки фронтенда
# ---------------------------------------------------------------------------
VITE_DEFAULT_CITY=Tallinn
VITE_DEFAULT_COUNTRY=EE
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=ru
# Центр карты по умолчанию (Ратушная площадь, Таллинн) — фолбэк без геолокации
VITE_DEFAULT_LAT=59.4370
VITE_DEFAULT_LNG=24.7536
# Сколько ИИ-запросов в день даём бесплатно (должно совпадать с DAILY_LIMIT в ai-chat)
VITE_AI_DAILY_LIMIT=10

# ---------------------------------------------------------------------------
# PostHog — ПУБЛИЧНЫЙ ingest-ключ, он и создан для браузера
# Где взять: https://app.posthog.com → Project Settings → Project API Key
# Если оставить пустым — аналитика молча отключается, приложение работает.
# ---------------------------------------------------------------------------
VITE_POSTHOG_KEY=
# us.i.posthog.com для US-региона, eu.i.posthog.com для EU (для Эстонии ближе EU)
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_ANALYTICS_ENABLED=true

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Признак продакшена: включает аналитику и строгие логи.
VITE_APP_ENV=development

# ============================================================================
# СЕКРЕТЫ — НЕ В ЭТОТ ФАЙЛ!
#
# Эти переменные НЕ имеют префикса VITE_ и НЕ должны попадать в бандл.
# Задаются только в Supabase Secrets:
#
#   supabase secrets set GEMINI_API_KEY=... OPENAI_API_KEY=... GOOGLE_PLACES_API_KEY=...
#
# Перечень:
#   GEMINI_API_KEY          — https://aistudio.google.com/apikey (есть бесплатный тариф)
#   OPENAI_API_KEY          — https://platform.openai.com/api-keys (чат-fallback + DALL·E 3)
#   GOOGLE_PLACES_API_KEY   — https://console.cloud.google.com (опционально, платный billing)
#   OPENWEATHER_API_KEY     — https://openweathermap.org/api (опционально, контекст для ИИ)
#   SUPABASE_SERVICE_ROLE_KEY — Supabase → Settings → API → service_role (⚠️ обходит RLS!)
#   ENVIRONMENT             — 'development' для подробных ошибок в ответах
#
# Проверить, что задано:
#   supabase secrets list
# ============================================================================
