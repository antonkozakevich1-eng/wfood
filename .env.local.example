# ============================================================================
# WFOOD — локальная разработка
#
# Скопируйте этот файл в .env.local:
#   Copy-Item .env.local.example .env.local      (Windows PowerShell)
#   cp .env.local.example .env.local             (macOS / Linux)
#
# ⚠️ .env.local в .gitignore. НИКОГДА не коммитьте его.
# ⚠️ После изменения .env.local перезапустите `npm run dev` —
#    Vite не подхватывает переменные окружения на лету.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (ПУБЛИЧНЫЕ)
# Supabase Dashboard → Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Настройки приложения (ПУБЛИЧНЫЕ)
# ---------------------------------------------------------------------------
VITE_DEFAULT_CITY=Tallinn
VITE_DEFAULT_COUNTRY=EE
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_LOCALE=ru
VITE_DEFAULT_LAT=59.4370
VITE_DEFAULT_LNG=24.7536
VITE_AI_DAILY_LIMIT=10
VITE_APP_ENV=development

# ---------------------------------------------------------------------------
# PostHog (ПУБЛИЧНЫЙ ключ). Пусто = аналитика выключена.
# ---------------------------------------------------------------------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_ANALYTICS_ENABLED=false

# ============================================================================
# Секретов здесь НЕТ и быть не должно.
#
# GEMINI_API_KEY, OPENAI_API_KEY, GOOGLE_PLACES_API_KEY и
# SUPABASE_SERVICE_ROLE_KEY задаются командой:
#
#   supabase secrets set --env-file ./supabase/.env.secrets
#
# Файл supabase/.env.secrets тоже в .gitignore.
#
# Edge Functions на локальном `npm run dev` НЕ работают: для полной
# локальной разработки бэкенда нужен `supabase start` (требует Docker).
# Без него фронтенд работает, а ИИ/загрузка мест показывают
# деградированное состояние — это ожидаемо и предусмотрено.
# ============================================================================
