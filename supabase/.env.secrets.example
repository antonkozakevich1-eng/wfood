# ============================================================================
# Секреты для Supabase Edge Functions
#
# Загружаются командой:
#   supabase secrets set --env-file ./supabase/.env.secrets
#
# ⚠️ Этот файл в .gitignore. НИКОГДА не коммитьте его.
# ⚠️ Значения должны быть БЕЗ кавычек и без пробелов вокруг '='.
# ============================================================================

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Cloud Console → APIs & Services → Credentials (опционально)
GOOGLE_PLACES_API_KEY=

# OpenWeatherMap → https://home.openweathermap.org/api_keys (опционально)
OPENWEATHER_API_KEY=

# Supabase → Settings → API → service_role
# ⚠️ Обходит RLS. Используется только внутри Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# 'development' → в ответах ai-chat появляется debugErrors
ENVIRONMENT=production

# Модели (можно переопределить без правки кода)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
